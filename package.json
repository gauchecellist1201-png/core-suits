{
  "name": "core-suits",
  "version": "0.1.0",
  "private": true,
  "description": "CORE Suits — オーダースーツ店のための AI Sales OS。顧客CRM × 自店の生地データベース × AI試着 × AIスタイリスト × 再来店提案。",
  "scripts": {
    "dev": "next dev -p 3400",
    "build": "next build",
    "start": "next start -p 3400",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "seed": "node scripts/seed.mjs",
    "seed:photos": "node scripts/generate-demo-assets.mjs",
    "check": "npm run typecheck && npm run test && node scripts/check-tenant-isolation.mjs && node scripts/check-no-public-photos.mjs && node scripts/check-cost-tracking.mjs && node scripts/check-demo-never-overrides.mjs && node scripts/check-no-fake-ai.mjs && node scripts/check-guards.mjs",
    "check:tenant": "node scripts/check-tenant-isolation.mjs",
    "check:photos": "node scripts/check-no-public-photos.mjs",
    "check:cost": "node scripts/check-cost-tracking.mjs",
    "check:demo": "node scripts/check-demo-never-overrides.mjs",
    "check:fake-ai": "node scripts/check-no-fake-ai.mjs",
    "check:guards": "node scripts/check-guards.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "next": "^15.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.13.0",
    "eslint-config-next": "^15.5.4",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.3",
    "vitest": "^2.1.2"
  }
}

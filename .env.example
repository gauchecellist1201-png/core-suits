# ── 必須 ───────────────────────────────────────────────────────
# セッション署名の鍵（24文字以上）。本番では必ず設定する。
#   openssl rand -base64 32
SUITS_SESSION_SECRET=

# 画像生成（試着）。未設定だと「試着をつくる」は押せない状態で表示される。
GEMINI_API_KEY=

# ── 任意 ───────────────────────────────────────────────────────
# 提案の理由づけ。未設定でも提案は出る（相性ルールの要約として表示される）。
ANTHROPIC_API_KEY=

# 画像生成の会社とモデル。1社に固定していないので、ここで差し替えられる。
SUITS_IMAGE_PROVIDER=gemini
SUITS_IMAGE_MODEL=gemini-3.1-flash-image
SUITS_TEXT_MODEL=claude-haiku-4-5-20251001

# 原価の円換算に使う為替。変動するので運用に合わせて更新する。
SUITS_USD_JPY=155

# ── 本番（Supabase）────────────────────────────────────────────
# この2つが入ると保管先は自動で Supabase になる。
# 入っていない本番デプロイは、ローカル保管に落ちずに起動時に止まる。
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
